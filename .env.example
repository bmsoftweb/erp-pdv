# Banco do ERP BMsoft (o mesmo dos outros módulos)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bmerp_000000

# Login (mesmo do erp-vendas)
# Segredo do cookie de sessão: pelo menos 32 caracteres, próprio deste app
SESSION_SECRET=
# Empresa usada quando o usuário não tem nenhuma liberada (sys_empresas.id)
ID_EMPRESA=1
# Endereço(s) do ERP-Master aceitos na volta de /api/entrar, separados por vírgula (vazio = só localhost)
MASTER_URL=


# Emissão de NFC-e/NF-e pelo concentrador do erp-nfe (o certificado fica só lá)
# Endereço do erp-nfe (ex.: http://localhost:3005) e o SESSION_SECRET dele
NFE_URL=
NFE_SECRET=

# PIX cobrado no banco (QR Code na tela, baixa automática) pelo BMBancos, onde ficam as credenciais do banco
# Endereço do BMBancos (ex.: http://localhost:3010) e o SESSION_SECRET dele; vazios = PIX lançado à mão
BANCOS_URL=
BANCOS_SECRET=
