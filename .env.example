# Banco do ERP BMsoft (o mesmo dos outros módulos)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bmerp_000000

# Login (mesmo do erp-vendas)
# Segredo do cookie de sessão: pelo menos 32 caracteres, próprio deste app
SESSION_SECRET=
# Empresa usada quando o usuário não tem nenhuma liberada (sys_empresas.id)
ID_EMPRESA=1
# Endereço(s) do BM-Master aceitos na volta de /api/entrar, separados por vírgula (vazio = só localhost)
MASTER_URL=


# Emissão de NFC-e/NF-e pelo concentrador do erp-nfe (o certificado fica só lá)
# Endereço do erp-nfe (ex.: http://localhost:3005) e o SESSION_SECRET dele
NFE_URL=
NFE_SECRET=

# Menu Fiscal › Identificação do PAF-NFC-e (Requisito VI, I) e registro U2 do Arquivo I: empresa desenvolvedora
PAF_DESENVOLVEDOR_RAZAO=BMSOFT
PAF_DESENVOLVEDOR_CNPJ=08511951000137
PAF_DESENVOLVEDOR_IE=
PAF_DESENVOLVEDOR_IM=
PAF_DESENVOLVEDOR_ENDERECO=
PAF_DESENVOLVEDOR_TELEFONE=
PAF_DESENVOLVEDOR_RESPONSAVEL=
# Arquitetura (alíneas c e d): na nuvem, seguida do nome da empresa contratada (§ 5º)
PAF_ARQ_BD=Banco de dados na nuvem - 
PAF_ARQ_SIST=PAF-NFC-e Nuvem - 
